<?php
$contentTitle = (string)($this->view->contentTitle ?? '');
$downloadUrl = (string)($this->view->downloadUrl ?? '');
if (!function_exists('content_zip_h')) {
    function content_zip_h($value): string {
        return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
    }
}
?>
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZIPダウンロード</title>
  <style>
  * { box-sizing: border-box; }
  body {
    background: #f5f6f7;
    color: #24292f;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    margin: 0;
    min-height: 100vh;
  }
  main {
    margin: 0 auto;
    max-width: 720px;
    padding: 12vh 20px 48px;
  }
  .download-icon {
    align-items: center;
    background: #e7f1ff;
    border: 1px solid #b6d4fe;
    border-radius: 6px;
    color: #0d6efd;
    display: flex;
    font-size: 28px;
    height: 56px;
    justify-content: center;
    margin-bottom: 20px;
    width: 56px;
  }
  h1 {
    font-size: 24px;
    margin: 0 0 10px;
  }
  .content-title {
    color: #57606a;
    font-size: 15px;
    margin: 0 0 24px;
    overflow-wrap: anywhere;
  }
  .status {
    align-items: center;
    display: flex;
    gap: 10px;
    margin-bottom: 24px;
  }
  .spinner {
    animation: spin 0.8s linear infinite;
    border: 2px solid #d0d7de;
    border-radius: 50%;
    border-top-color: #0d6efd;
    height: 18px;
    width: 18px;
  }
  .download-button {
    align-items: center;
    background: #0d6efd;
    border: 1px solid #0d6efd;
