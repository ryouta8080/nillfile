    color: #fff;
    display: inline-flex;
    font-size: 15px;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    text-decoration: none;
  }
  .download-button:focus,
  .download-button:hover {
    background: #0b5ed7;
    border-color: #0a58ca;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 575px) {
    main { padding-top: 64px; }
    h1 { font-size: 21px; }
    .download-button { width: 100%; }
  }
  </style>
</head>
<body>
<main>
  <div class="download-icon" aria-hidden="true">ZIP</div>
  <h1>認証が完了しました</h1>
  <?php if ($contentTitle !== ''): ?>
    <p class="content-title"><?php echo content_zip_h($contentTitle); ?></p>
  <?php endif; ?>
  <div class="status" id="downloadStatus" role="status">
    <span class="spinner" aria-hidden="true"></span>
    <span>ZIPダウンロードを開始しています</span>
  </div>
  <a class="download-button" id="downloadButton" href="<?php echo content_zip_h($downloadUrl); ?>">ZIPをダウンロード</a>
</main>
<script>
(function(){
  var downloadUrl = <?php echo json_encode($downloadUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;
  var status = document.getElementById('downloadStatus');
  if (!downloadUrl) return;
  window.setTimeout(function(){
    window.location.assign(downloadUrl);
    window.setTimeout(function(){
      if (status) status.lastElementChild.textContent = 'ZIPダウンロードを開始しました';
    }, 1000);
  }, 400);
})();
</script>
</body>
</html>
