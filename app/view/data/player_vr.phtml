<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>
(function () {
  const IMAGE_PRESETS = <?php echo json_encode($imagePresets, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); ?>;
  const VR_DEBUG = <?php echo $vrDebug ? 'true' : 'false'; ?>;

  const viewer = document.getElementById('viewer');
  const menu = document.getElementById('menu');
  const audioMuteBtn = document.getElementById('audioMuteBtn');
  const revealHint = document.getElementById('revealHint');
  const recenterBtn = document.getElementById('recenterBtn');
  const fullscreenBtn = document.getElementById('fullscreenBtn');
  const resetZoomBtn = document.getElementById('resetZoomBtn');
  const vrBtn = document.getElementById('vrBtn');
  const dragModeBtn = document.getElementById('dragModeBtn');
  const gyroModeBtn = document.getElementById('gyroModeBtn');
  const imagePresetRow = document.getElementById('imagePresetRow');
  const imageSwitchGroup = document.getElementById('imageSwitchGroup');
  const loadingOverlay = document.getElementById('loadingOverlay');
  const loadingText = document.getElementById('loadingText');
  const audioPromptOverlay = document.getElementById('audioPromptOverlay');
  const audioPromptEnable = document.getElementById('audioPromptEnable');
  const audioPromptPlayBtn = document.getElementById('audioPromptPlayBtn');

  const zee = new THREE.Vector3(0, 0, 1);
  const euler = new THREE.Euler();
  const q0 = new THREE.Quaternion();
  const q1 = new THREE.Quaternion(-Math.sqrt(0.5), 0, 0, Math.sqrt(0.5));
  const listenerDirection = new THREE.Vector3();
  const listenerPosition = new THREE.Vector3();
  const audioDirection = new THREE.Vector3();
  const AUDIO_OFF_AXIS_VOLUME = 0.5;

  const state = {
    yaw: 0,
    pitch: 0,
    roll: 0,
    fov: 60,
    initialFov: 60,
    minFov: 18,
    maxFov: 90,
    mode: 'drag',
    dragging: false,
    lastX: 0,
    lastY: 0,
    hiddenMenu: false,
    tapDownX: 0,
    tapDownY: 0,
    tapDownTime: 0,
    gyroBaseQuat: null,
    smoothQuat: new THREE.Quaternion(),
    currentQuat: new THREE.Quaternion(),
    orientationReceived: false,
    presetIndex: 0,
    activeLoadToken: 0,
    mediaYawOffset: 0,
    audioMuted: false,
    audioAvailable: false,
    currentAudioBuffers: null
  };

  let scene, camera, renderer, sphere, audioListener = null, audioDebugGroup = null, currentTexture = null, currentVideo = null;
  const activePointers = new Map();
  const audioBufferCache = new Map();
  let currentAudioSources = [];
  let pinchStartDistance = 0;
  let pinchStartFov = state.fov;

  function clamp(v, min, max){
    return Math.min(max, Math.max(min, v));
  }

  function wrap180(v){
    return ((v + 180) % 360 + 360) % 360 - 180;
  }

  function getPresetYawOffset(item){
    if(!item) return 0;
    const value = item.yaw ?? item.yawOffset ?? item.yOffset ?? 0;
    const offset = Number(value);
    return Number.isFinite(offset) ? offset : 0;
  }

  function applyMediaYawOffset(item){
    state.mediaYawOffset = getPresetYawOffset(item);
    if(sphere){
      sphere.rotation.y = -Math.PI / 2 + THREE.MathUtils.degToRad(state.mediaYawOffset);
    }
  }

  function canFullscreen(){
    return !!(document.fullscreenEnabled && document.documentElement.requestFullscreen);
  }

  function showHint(){
    revealHint.classList.add('show');
    clearTimeout(showHint._timer);
    showHint._timer = setTimeout(() => revealHint.classList.remove('show'), 1400);
  }

  function setMenuHidden(hidden){
    state.hiddenMenu = hidden;
    menu.classList.toggle('hidden', hidden);
    audioMuteBtn.classList.toggle('hidden', hidden);
    if(hidden) showHint();
  }

  function setLoading(show, text){
    loadingText.textContent = text || '画像を読み込み中...';
    loadingOverlay.classList.toggle('show', show);
  }

  function updateModeButtons(){
    const dragActive = state.mode === 'drag';
    dragModeBtn.classList.toggle('active', dragActive);
    gyroModeBtn.classList.toggle('active', !dragActive);
    dragModeBtn.setAttribute('aria-pressed', dragActive ? 'true' : 'false');
    gyroModeBtn.setAttribute('aria-pressed', !dragActive ? 'true' : 'false');
  }

  function renderImagePresetButtons(){
    const presets = Array.isArray(IMAGE_PRESETS) ? IMAGE_PRESETS : [];
    imageSwitchGroup.innerHTML = '';

    if(presets.length <= 1){
      imagePresetRow.style.display = 'none';
      return;
    }

    imagePresetRow.style.display = '';
    imageSwitchGroup.classList.toggle('multi', presets.length !== 2);

    presets.forEach((item, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'switch-option' + (index === state.presetIndex ? ' active' : '');
      button.textContent = item.label || String(index + 1);
      button.setAttribute('aria-pressed', index === state.presetIndex ? 'true' : 'false');
      button.addEventListener('click', async () => {
        if(index === state.presetIndex) return;
        state.presetIndex = index;
        renderImagePresetButtons();
        await loadPresetByIndex(index);
      });
      imageSwitchGroup.appendChild(button);
    });
  }

  function resize(){
    const w = Math.max(window.innerWidth, 320);
    const h = Math.max(window.innerHeight, 180);
    renderer.setSize(w, h, false);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    render();
  }

  function applyCamera(){
    camera.rotation.order = 'YXZ';
    camera.rotation.y = THREE.MathUtils.degToRad(state.yaw);
    camera.rotation.x = THREE.MathUtils.degToRad(state.pitch);
    camera.rotation.z = THREE.MathUtils.degToRad(state.roll);
    camera.fov = state.fov;
    camera.updateProjectionMatrix();
  }

  function render(){
    applyCamera();
    updateDirectionalAudioVolumes();
    renderer.render(scene, camera);
  }

  function resumeAudioContext(){
    if(audioListener && audioListener.context && audioListener.context.state === 'suspended'){
      audioListener.context.resume().catch(() => {});
    }
  }

  function animate(){
    renderer.setAnimationLoop(render);
  }

  function initThree(){
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(state.fov, window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.set(0, 0, 0.1);
    audioListener = new THREE.AudioListener();
    camera.add(audioListener);
    scene.add(camera);

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.xr.enabled = true;
    viewer.appendChild(renderer.domElement);

    const geometry = new THREE.SphereGeometry(500, 64, 40);
    geometry.scale(-1, 1, 1);
    const material = new THREE.MeshBasicMaterial({ color: 0xffffff });
    sphere = new THREE.Mesh(geometry, material);
    applyMediaYawOffset(IMAGE_PRESETS[0]);
    scene.add(sphere);
    audioDebugGroup = new THREE.Group();
    scene.add(audioDebugGroup);

    resize();
    animate();
  }

  function disposeTexture(){
    if(currentVideo){
      currentVideo.pause();
      currentVideo.removeAttribute('src');
      currentVideo.load();
      currentVideo = null;
    }
    if(currentTexture){
      currentTexture.dispose();
      currentTexture = null;
    }
  }

  function disposeAudioSources(){
    currentAudioSources.forEach((audio) => {
      try{
        audio.userData.disposed = true;
        if(audio.isPlaying){
          audio.stop();
        }
        if(audio.parent){
          audio.parent.remove(audio);
        }
      }catch(err){
      }
    });
    currentAudioSources = [];
  }

  function updateAudioMuteButton(){
    audioMuteBtn.classList.toggle('show', state.audioAvailable);
    audioMuteBtn.classList.toggle('muted', state.audioMuted);
    audioMuteBtn.setAttribute('aria-pressed', state.audioMuted ? 'true' : 'false');
    audioMuteBtn.setAttribute('aria-label', state.audioMuted ? '音声ミュートを解除' : '音声をミュート');
  }

  function applyAudioMutedState(){
    updateDirectionalAudioVolumes();
    updateAudioMuteButton();
  }

  function getDirectionalAudioScale(audio){
    if(!camera || !audio) return 1;
    camera.getWorldDirection(listenerDirection);
    camera.getWorldPosition(listenerPosition);
    audio.getWorldPosition(audioDirection);
    audioDirection.sub(listenerPosition);
    if(audioDirection.lengthSq() <= 0.000001) return 1;
    audioDirection.normalize();
    const facing = clamp(listenerDirection.dot(audioDirection), -1, 1);
    return AUDIO_OFF_AXIS_VOLUME + ((facing + 1) / 2) * (1 - AUDIO_OFF_AXIS_VOLUME);
  }

  function updateDirectionalAudioVolumes(){
    currentAudioSources.forEach((audio) => {
      const baseVolume = Number.isFinite(audio.userData.baseVolume) ? audio.userData.baseVolume : 1;
      const directionalScale = getDirectionalAudioScale(audio);
      audio.setVolume(state.audioMuted ? 0 : baseVolume * directionalScale);
    });
  }

  function setAudioAvailable(available, muted = state.audioMuted, audioBuffers = null){
    state.audioAvailable = !!available;
    state.audioMuted = !!muted;
    state.currentAudioBuffers = audioBuffers;
    if(!state.audioAvailable){
      state.currentAudioBuffers = null;
      state.audioMuted = false;
      disposeAudioSources();
    }
    applyAudioMutedState();
  }

  function toggleAudioMuted(){
    if(!state.audioAvailable) return;
    state.audioMuted = !state.audioMuted;
    if(!state.audioMuted && currentAudioSources.length === 0 && state.currentAudioBuffers){
      resumeAudioContext();
      applyAudioForPreset(state.currentAudioBuffers);
    }
    applyAudioMutedState();
  }

  function clearAudioDebugMarkers(){
    if(!audioDebugGroup) return;
    while(audioDebugGroup.children.length){
      const child = audioDebugGroup.children.pop();
      if(child.material){
        if(child.material.map){
          child.material.map.dispose();
        }
        child.material.dispose();
      }
    }
  }

  function createAudioDebugTexture(index){
    const size = 128;
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, size, size);
    ctx.beginPath();
    ctx.arc(size / 2, size / 2, 44, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(76, 201, 240, 0.92)';
    ctx.fill();
    ctx.lineWidth = 7;
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.95)';
    ctx.stroke();
    ctx.fillStyle = '#05070a';
    ctx.font = '700 54px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(String(index), size / 2, size / 2 + 2);
    const texture = new THREE.CanvasTexture(canvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    return texture;
  }

  function renderAudioDebugMarkers(item){
    if(!VR_DEBUG || !audioDebugGroup) return;
    clearAudioDebugMarkers();
    getAudioItems(item).forEach((audioItem, index) => {
      const position = Array.isArray(audioItem.position) ? audioItem.position : null;
      if(!position) return;
      const texture = createAudioDebugTexture(index + 1);
      const material = new THREE.SpriteMaterial({
        map: texture,
        depthTest: false,
        depthWrite: false,
        transparent: true
      });
      const sprite = new THREE.Sprite(material);
      sprite.position.set(
        Number(position[0]) || 0,
        Number(position[1]) || 0,
        Number(position[2]) || 0
      );
      sprite.scale.set(1.2, 1.2, 1.2);
      audioDebugGroup.add(sprite);
    });
    render();
  }

  function applyTexture(texture){
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.minFilter = THREE.LinearFilter;
    texture.magFilter = THREE.LinearFilter;
    texture.generateMipmaps = false;

    disposeTexture();
    currentTexture = texture;
    sphere.material.map = texture;
    sphere.material.needsUpdate = true;
    render();
  }

  function applyTextureFromImage(img){
    const texture = new THREE.Texture(img);
    texture.needsUpdate = true;
    applyTexture(texture);
  }

  function applyTextureFromVideo(video){
    const texture = new THREE.VideoTexture(video);
    applyTexture(texture);
    currentVideo = video;
  }

  function loadImage(src){
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error('画像を読み込めませんでした'));
      img.src = src;
    });
  }

  function getVideoBufferedPercent(video){
    if(!Number.isFinite(video.duration) || video.duration <= 0 || video.buffered.length === 0) return null;
    let bufferedEnd = 0;
    for(let i = 0; i < video.buffered.length; i++){
      bufferedEnd = Math.max(bufferedEnd, video.buffered.end(i));
    }
    return clamp(Math.floor((bufferedEnd / video.duration) * 100), 0, 100);
  }

  function formatVideoLoadText(stage, percent){
    const base = stage === 'metadata' ? '動画情報を読み込み中...' : '動画と音声を読み込み中...';
    return percent == null ? base : (base + ' ' + percent + '%');
  }

  function getAudioItems(item){
    if(item && Array.isArray(item.selectedAudio)){
      return item.selectedAudio;
    }
    return item && Array.isArray(item.audio) ? item.audio : [];
  }

  function getAudioSrc(audioItem){
    return audioItem && audioItem.src ? String(audioItem.src) : '';
  }

  function chooseWeightedAudioVariant(variants){
    const choices = Array.isArray(variants) ? variants.filter((variant) => variant && variant.src) : [];
    if(choices.length === 0) return null;
    const total = choices.reduce((sum, variant) => {
      const weight = Number(variant.weight);
      return sum + (Number.isFinite(weight) && weight > 0 ? weight : 0);
    }, 0);
    if(total <= 0){
      return choices[Math.floor(Math.random() * choices.length)];
    }

    let target = Math.random() * total;
    for(const variant of choices){
      const weight = Number(variant.weight);
      const normalized = Number.isFinite(weight) && weight > 0 ? weight : 0;
      target -= normalized;
      if(target <= 0){
        return variant;
      }
    }
    return choices[choices.length - 1];
  }

  function prepareAudioItems(item){
    if(!item || !Array.isArray(item.audio)){
      return [];
    }
    item.selectedAudio = item.audio.map((audioItem) => {
      if(!audioItem || !Array.isArray(audioItem.variants)){
        return audioItem;
      }
      const variants = audioItem.variants.filter((variant) => variant && variant.src);
      return Object.assign({}, audioItem, { variants });
    }).filter((audioItem) => !!getAudioSrc(audioItem) || (Array.isArray(audioItem.variants) && audioItem.variants.length > 0));
    return item.selectedAudio;
  }

  function getPresetLoadSources(item){
    const sources = [];
    const mediaSrc = getMediaSrc(item);
    if(mediaSrc){
      sources.push(mediaSrc);
    }
    getAudioItems(item).forEach((audioItem) => {
      if(Array.isArray(audioItem.variants)){
        audioItem.variants.forEach((variant) => {
          if(variant && variant.src){
            variant.loadIndex = sources.length;
            sources.push(variant.src);
          }
        });
        return;
      }
      const src = getAudioSrc(audioItem);
      if(src){
        audioItem.loadIndex = sources.length;
        sources.push(src);
      }
    });
    return sources;
  }

  async function getContentLength(src){
    try{
      const response = await fetch(src, { method: 'HEAD', cache: 'force-cache' });
      if(!response.ok) return 0;
      const length = Number(response.headers.get('Content-Length') || 0);
      return Number.isFinite(length) && length > 0 ? length : 0;
    }catch(err){
      return 0;
    }
  }

  async function createPresetLoadProgress(item, onProgress){
    const sources = getPresetLoadSources(item);
    const totals = await Promise.all(sources.map(getContentLength));
    const loaded = sources.map(() => 0);
    let lastPercent = null;

    const notify = () => {
      const totalBytes = totals.reduce((sum, value) => sum + value, 0);
      if(totalBytes <= 0){
        lastPercent = null;
        if(typeof onProgress === 'function'){
          onProgress(null);
        }
        return;
      }
      const loadedBytes = loaded.reduce((sum, value) => sum + value, 0);
      lastPercent = clamp(Math.floor((loadedBytes / totalBytes) * 100), 0, 99);
      if(typeof onProgress === 'function'){
        onProgress(lastPercent);
      }
    };

    return {
      get percent(){
        return lastPercent;
      },
      report(index, loadedBytes, totalBytes){
        if(!Number.isInteger(index) || index < 0 || index >= loaded.length) return;
        if(Number.isFinite(totalBytes) && totalBytes > totals[index]){
          totals[index] = totalBytes;
        }
        loaded[index] = Math.max(loaded[index], Number(loadedBytes) || 0);
        notify();
      },
      complete(index, totalBytes){
        if(!Number.isInteger(index) || index < 0 || index >= loaded.length) return;
        if(Number.isFinite(totalBytes) && totalBytes > totals[index]){
          totals[index] = totalBytes;
        }
        loaded[index] = totals[index] > 0 ? totals[index] : Math.max(loaded[index], Number(totalBytes) || 0);
        notify();
      },
      finish(){
        lastPercent = 100;
        if(typeof onProgress === 'function'){
          onProgress(100);
        }
      }
    };
  }

  const VIDEO_PRELOAD_MAX_READY = 3;
  const videoPreloadCache = new Map();
  let videoPreloadQueue = [];
  let videoPreloadRunning = false;

  function getMediaSrc(item){
    return item && item.image ? String(item.image) : '';
  }

  function shouldPreloadVideo(item){
    return isVideoPreset(item) && item.preload !== false && !!getMediaSrc(item);
  }

  function getVideoPreloadEntry(item){
    const src = getMediaSrc(item);
    if(!src) return null;
    let entry = videoPreloadCache.get(src);
    if(!entry){
      entry = {
        src,
        status: 'idle',
        percent: null,
        objectUrl: null,
        promise: null,
        listeners: new Set(),
        lastUsed: 0
      };
      videoPreloadCache.set(src, entry);
    }
    return entry;
  }

  function notifyVideoPreload(entry, stage, percent){
    entry.listeners.forEach((listener) => {
      try{
        listener(stage, percent);
      }catch(err){
      }
    });
  }

  function touchVideoPreload(entry){
    entry.lastUsed = Date.now();
  }

  function enforceVideoPreloadLimit(){
    const readyEntries = Array.from(videoPreloadCache.values())
      .filter((entry) => entry.status === 'ready' && entry.objectUrl && entry.src !== getMediaSrc(IMAGE_PRESETS[state.presetIndex]))
      .sort((a, b) => a.lastUsed - b.lastUsed);

    while(readyEntries.length > VIDEO_PRELOAD_MAX_READY){
      const entry = readyEntries.shift();
      if(!entry) break;
      URL.revokeObjectURL(entry.objectUrl);
      entry.objectUrl = null;
      entry.status = 'idle';
      entry.percent = null;
      entry.promise = null;
    }
  }

  async function readResponseBlobWithProgress(response, entry, onBytes){
    const total = Number(response.headers.get('Content-Length') || 0);
    const contentType = response.headers.get('Content-Type') || 'video/mp4';

    if(!response.body || !response.body.getReader){
      const blob = await response.blob();
      if(typeof onBytes === 'function'){
        onBytes(blob.size, total || blob.size);
      }
      entry.percent = 100;
      notifyVideoPreload(entry, 'download', 100);
      return blob;
    }

    const reader = response.body.getReader();
    const chunks = [];
    let loaded = 0;

    while(true){
      const result = await reader.read();
      if(result.done) break;
      if(result.value){
        chunks.push(result.value);
        loaded += result.value.length;
        if(total > 0){
          entry.percent = clamp(Math.floor((loaded / total) * 100), 0, 99);
          notifyVideoPreload(entry, 'download', entry.percent);
        }else{
          notifyVideoPreload(entry, 'download', null);
        }
        if(typeof onBytes === 'function'){
          onBytes(loaded, total);
        }
      }
    }

    if(typeof onBytes === 'function'){
      onBytes(total || loaded, total || loaded);
    }
    entry.percent = 100;
    notifyVideoPreload(entry, 'download', 100);
    return new Blob(chunks, { type: contentType });
  }

  function startVideoPreload(item, onBytes){
    const entry = getVideoPreloadEntry(item);
    if(!entry) return Promise.reject(new Error('Video source is empty'));
    if(entry.status === 'ready' && entry.objectUrl){
      touchVideoPreload(entry);
      if(typeof onBytes === 'function'){
        onBytes(1, 1);
      }
      return Promise.resolve(entry.objectUrl);
    }
    if(entry.promise){
      return entry.promise;
    }

    entry.status = 'loading';
    entry.percent = null;
    notifyVideoPreload(entry, 'download', null);
    entry.promise = (async () => {
      const response = await fetch(entry.src, { cache: 'force-cache' });
      if(!response.ok){
        throw new Error('Video preload failed');
      }

      const blob = await readResponseBlobWithProgress(response, entry, onBytes);
      if(entry.objectUrl){
        URL.revokeObjectURL(entry.objectUrl);
      }
      entry.objectUrl = URL.createObjectURL(blob);
      entry.status = 'ready';
      entry.percent = 100;
      touchVideoPreload(entry);
      enforceVideoPreloadLimit();
      return entry.objectUrl;
    })().catch((err) => {
      entry.status = 'error';
      entry.percent = null;
      entry.promise = null;
      notifyVideoPreload(entry, 'download', null);
      throw err;
    });

    return entry.promise;
  }

  function preloadVideoForUse(item, onProgress, onBytes){
    const entry = getVideoPreloadEntry(item);
    if(!entry) return Promise.reject(new Error('Video source is empty'));

    if(typeof onProgress === 'function'){
      entry.listeners.add(onProgress);
      onProgress('download', entry.percent);
    }

    return startVideoPreload(item, onBytes).finally(() => {
      if(typeof onProgress === 'function'){
        entry.listeners.delete(onProgress);
      }
    });
  }

  async function loadVideoForPreset(item, onProgress, onBytes, autoPlay = true){
    if(!shouldPreloadVideo(item)){
      return loadVideo(item.image, onProgress, autoPlay);
    }

    const objectUrl = await preloadVideoForUse(item, (stage, percent) => {
      if(typeof onProgress === 'function'){
        onProgress(stage, percent);
      }
    }, onBytes);

    return loadVideo(objectUrl, (stage, percent) => {
      if(typeof onProgress === 'function'){
        onProgress(stage, percent == null ? 100 : percent);
      }
    }, autoPlay);
  }

  async function readResponseArrayBufferWithProgress(response, onBytes){
    const total = Number(response.headers.get('Content-Length') || 0);
    if(!response.body || !response.body.getReader){
      const buffer = await response.arrayBuffer();
      if(typeof onBytes === 'function'){
        onBytes(buffer.byteLength, total || buffer.byteLength);
      }
      return buffer;
    }

    const reader = response.body.getReader();
    const chunks = [];
    let loaded = 0;
    while(true){
      const result = await reader.read();
      if(result.done) break;
      if(result.value){
        chunks.push(result.value);
        loaded += result.value.length;
        if(typeof onBytes === 'function'){
          onBytes(loaded, total);
        }
      }
    }

    const buffer = new Uint8Array(loaded);
    let offset = 0;
    chunks.forEach((chunk) => {
      buffer.set(chunk, offset);
      offset += chunk.length;
    });
    if(typeof onBytes === 'function'){
      onBytes(total || loaded, total || loaded);
    }
    return buffer.buffer;
  }

  async function loadAudioBuffer(audioItem, onBytes){
    const src = getAudioSrc(audioItem);
    if(!src) return null;
    if(audioBufferCache.has(src)){
      if(typeof onBytes === 'function'){
        onBytes(1, 1);
      }
      return audioBufferCache.get(src);
    }

    const response = await fetch(src, { cache: 'force-cache' });
    if(!response.ok){
      throw new Error('Audio preload failed');
    }
    const arrayBuffer = await readResponseArrayBufferWithProgress(response, onBytes);
    const audioBuffer = await audioListener.context.decodeAudioData(arrayBuffer.slice(0));
    audioBufferCache.set(src, audioBuffer);
    return audioBuffer;
  }

  async function loadAudioForPreset(item, progress){
    const audioItems = getAudioItems(item);
    const results = [];
    for(let i = 0; i < audioItems.length; i++){
      const audioItem = audioItems[i];
      if(Array.isArray(audioItem.variants) && audioItem.variants.length > 0){
        const variants = [];
        for(const variant of audioItem.variants){
          const buffer = await loadAudioBuffer(variant, (loadedBytes, totalBytes) => {
            if(progress){
              progress.report(variant.loadIndex, loadedBytes, totalBytes);
            }
          });
          if(buffer && progress){
            progress.complete(variant.loadIndex);
          }
          if(buffer){
            variants.push(Object.assign({}, variant, { buffer }));
          }
        }
        if(variants.length > 0){
          results.push({ item: audioItem, variants });
        }
        continue;
      }
      const sourceIndex = audioItem.loadIndex;
      const buffer = await loadAudioBuffer(audioItem, (loadedBytes, totalBytes) => {
        if(progress){
          progress.report(sourceIndex, loadedBytes, totalBytes);
        }
      });
      if(buffer && progress){
        progress.complete(sourceIndex);
      }
      if(buffer){
        results.push({ item: audioItem, buffer });
      }
    }
    return results;
  }

  function applyAudioForPreset(audioBuffers){
    disposeAudioSources();
    if(!audioListener || !Array.isArray(audioBuffers)) return;

    audioBuffers.forEach(({ item, buffer, variants }) => {
      const audio = new THREE.PositionalAudio(audioListener);
      const baseVolume = Number.isFinite(Number(item.volume)) ? Number(item.volume) : 1;
      audio.userData.baseVolume = baseVolume;
      audio.setVolume(state.audioMuted ? 0 : baseVolume * getDirectionalAudioScale(audio));
      audio.setRefDistance(Number.isFinite(Number(item.refDistance)) ? Number(item.refDistance) : 8);
      audio.setRolloffFactor(Number.isFinite(Number(item.rolloffFactor)) ? Number(item.rolloffFactor) : 1);
      audio.setDistanceModel(item.distanceModel || 'inverse');

      const position = Array.isArray(item.position) ? item.position : [0, 0, -10];
      audio.position.set(
        Number(position[0]) || 0,
        Number(position[1]) || 0,
        Number(position[2]) || 0
      );
      scene.add(audio);
      currentAudioSources.push(audio);

      if(Array.isArray(variants) && variants.length > 0){
        audio.userData.disposed = false;
        let sequenceIndex = 0;
        const playNextVariant = () => {
          if(audio.userData.disposed || !audio.parent) return;
          const mode = item.mode === 'sequence' ? 'sequence' : 'random';
          let variant = null;
          if(mode === 'sequence'){
            variant = variants[sequenceIndex % variants.length];
            sequenceIndex++;
          }else{
            variant = chooseWeightedAudioVariant(variants);
          }
          if(!variant || !variant.buffer) return;
          try{
            if(audio.isPlaying){
              audio.stop();
            }
            audio.setBuffer(variant.buffer);
            audio.setLoop(false);
            audio.play();
            if(audio.source){
              const onEnded = audio.source.onended;
              audio.source.onended = () => {
                if(typeof onEnded === 'function'){
                  onEnded();
                }
                playNextVariant();
              };
            }
          }catch(err){
          }
        };
        playNextVariant();
        return;
      }

      if(buffer){
        audio.setBuffer(buffer);
        audio.setLoop(item.loop !== false);
        try{
          audio.play();
        }catch(err){
        }
      }
    });
  }

  audioMuteBtn.addEventListener('click', toggleAudioMuted);

  function requestPlaybackWithAudioPrompt(){
    audioPromptEnable.checked = true;
    audioPromptOverlay.classList.add('show');
    return new Promise((resolve) => {
      const onPlay = () => {
        audioPromptPlayBtn.removeEventListener('click', onPlay);
        audioPromptOverlay.classList.remove('show');
        resumeAudioContext();
        resolve(audioPromptEnable.checked);
      };
      audioPromptPlayBtn.addEventListener('click', onPlay);
      audioPromptPlayBtn.focus();
    });
  }

  function scheduleVideoPreloads(exceptIndex){
    const presets = Array.isArray(IMAGE_PRESETS) ? IMAGE_PRESETS : [];
    videoPreloadQueue = presets
      .map((item, index) => ({ item, index }))
      .filter(({ item, index }) => index !== exceptIndex && shouldPreloadVideo(item))
      .filter(({ item }) => {
        const entry = getVideoPreloadEntry(item);
        return entry && entry.status !== 'ready' && entry.status !== 'loading';
      });

    runVideoPreloadQueue();
  }

  function runVideoPreloadQueue(){
    if(videoPreloadRunning) return;
    videoPreloadRunning = true;

    const next = () => {
      const queued = videoPreloadQueue.shift();
      if(!queued){
        videoPreloadRunning = false;
        return;
      }

      startVideoPreload(queued.item).catch(() => {}).finally(() => {
        const runNext = () => next();
        if('requestIdleCallback' in window){
          window.requestIdleCallback(runNext, { timeout: 1500 });
        }else{
          setTimeout(runNext, 300);
        }
      });
    };

    if('requestIdleCallback' in window){
      window.requestIdleCallback(next, { timeout: 1500 });
    }else{
      setTimeout(next, 300);
    }
  }

  window.addEventListener('beforeunload', () => {
    videoPreloadCache.forEach((entry) => {
      if(entry.objectUrl){
        URL.revokeObjectURL(entry.objectUrl);
      }
    });
  });

  function loadVideo(src, onProgress, autoPlay = true){
    return new Promise((resolve, reject) => {
      const video = document.createElement('video');
      video.crossOrigin = 'anonymous';
      video.preload = 'auto';
      video.loop = true;
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');

      let resolved = false;
      const report = (stage) => {
        if(typeof onProgress === 'function'){
          onProgress(stage, getVideoBufferedPercent(video));
        }
      };
      const cleanup = () => {
        video.removeEventListener('loadstart', onLoadStart);
        video.removeEventListener('loadedmetadata', onLoadedMetadata);
        video.removeEventListener('loadeddata', onProgressEvent);
        video.removeEventListener('progress', onProgressEvent);
        video.removeEventListener('stalled', onProgressEvent);
        video.removeEventListener('waiting', onProgressEvent);
        video.removeEventListener('suspend', onProgressEvent);
        video.removeEventListener('canplay', onReady);
        video.removeEventListener('playing', onReady);
        video.removeEventListener('error', onError);
      };
      const onLoadStart = () => report('loadstart');
      const onLoadedMetadata = () => report('metadata');
      const onProgressEvent = () => report('buffering');
      const onReady = async () => {
        if(resolved) return;
        report('buffering');
        if(autoPlay){
          try{
            await video.play();
          }catch(err){
            cleanup();
            reject(err);
            return;
          }
        }
        resolved = true;
        cleanup();
        resolve(video);
      };
      const onError = () => {
        cleanup();
        reject(new Error('Video load failed'));
      };

      video.addEventListener('loadstart', onLoadStart);
      video.addEventListener('loadedmetadata', onLoadedMetadata);
      video.addEventListener('loadeddata', onProgressEvent);
      video.addEventListener('progress', onProgressEvent);
      video.addEventListener('stalled', onProgressEvent);
      video.addEventListener('waiting', onProgressEvent);
      video.addEventListener('suspend', onProgressEvent);
      video.addEventListener('canplay', onReady);
      video.addEventListener('playing', onReady);
      video.addEventListener('error', onError, { once: true });
      report('loadstart');
      video.src = src;
      video.load();
    });
  }

  function waitForVideoFrame(video){
    return new Promise((resolve) => {
      let done = false;
      const finish = () => {
        if(done) return;
        done = true;
        cleanup();
        resolve();
      };
      const hasPlaybackFrame = () => video.readyState >= 2 && !video.paused && video.currentTime > 0;
      const check = () => {
        if(hasPlaybackFrame()) finish();
      };
      const cleanup = () => {
        video.removeEventListener('playing', check);
        video.removeEventListener('timeupdate', check);
        video.removeEventListener('canplay', check);
        clearInterval(timer);
        clearTimeout(maxWait);
      };
      if(typeof video.requestVideoFrameCallback === 'function') {
        video.requestVideoFrameCallback(() => finish());
      }
      video.addEventListener('playing', check);
      video.addEventListener('timeupdate', check);
      video.addEventListener('canplay', check);
      const timer = setInterval(check, 120);
      const maxWait = setTimeout(finish, 30000);
      check();
    });
  }
  function isVideoPreset(item){
    if(!item) return false;
    if(item.type === 'video') return true;
    const src = String(item.image || '');
    try{
      const url = new URL(src, window.location.href);
      const imageName = url.searchParams.get('image') || url.searchParams.get('f') || url.pathname;
      return imageName.toLowerCase().endsWith('.mp4') || imageName.toLowerCase().startsWith('movie:');
    }catch(err){
      const cleanSrc = src.split('?')[0].toLowerCase();
      return cleanSrc.endsWith('.mp4') || cleanSrc.startsWith('movie:');
    }
  }

  async function loadMediaSource(item, label){
    const loadToken = ++state.activeLoadToken;
    const isVideo = isVideoPreset(item);
    const loadingLabel = isVideo ? '動画を読み込み中...' : '画像を読み込み中...';
    setLoading(true, label ? (loadingLabel + ' ' + label) : loadingLabel);
    let loadingClosed = false;

    try{
      if(!isVideo){
        const img = await loadImage(item.image);
        if(loadToken !== state.activeLoadToken) return;
        applyMediaYawOffset(item);
        setAudioAvailable(false);
        clearAudioDebugMarkers();
        applyTextureFromImage(img);
        setLoading(false);
        loadingClosed = true;
        scheduleVideoPreloads(state.presetIndex);
        return;
      }

      const hasAudio = prepareAudioItems(item).length > 0;
      const progress = await createPresetLoadProgress(item, (percent) => {
        if(loadToken !== state.activeLoadToken) return;
        const text = formatVideoLoadText('download', percent);
        setLoading(true, label ? (text + ' ' + label) : text);
      });
      const video = await loadVideoForPreset(item, (stage) => {
        if(loadToken !== state.activeLoadToken) return;
        const text = formatVideoLoadText(stage, progress.percent);
        setLoading(true, label ? (text + ' ' + label) : text);
      }, (loadedBytes, totalBytes) => {
        progress.report(0, loadedBytes, totalBytes);
      }, !hasAudio);
      if(loadToken !== state.activeLoadToken){
        video.pause();
        video.removeAttribute('src');
        video.load();
        return;
      }
      progress.complete(0);
      const audioBuffers = await loadAudioForPreset(item, progress);
      if(loadToken !== state.activeLoadToken){
        video.pause();
        video.removeAttribute('src');
        video.load();
        return;
      }
      progress.finish();
      applyMediaYawOffset(item);
      applyTextureFromVideo(video);
      renderAudioDebugMarkers(item);
      if(hasAudio){
        setLoading(false);
        loadingClosed = true;
        const soundEnabled = await requestPlaybackWithAudioPrompt();
        if(loadToken !== state.activeLoadToken){
          video.pause();
          video.removeAttribute('src');
          video.load();
          return;
        }
        setLoading(true, label ? ('再生準備中... ' + label) : '再生準備中...');
        if(soundEnabled){
          setAudioAvailable(true, false, audioBuffers);
          applyAudioForPreset(audioBuffers);
        }else{
          setAudioAvailable(false);
        }
        loadingClosed = false;
        await video.play();
      }else{
        setAudioAvailable(false);
        setLoading(true, label ? ('再生準備中... ' + label) : '再生準備中...');
      }
      await waitForVideoFrame(video);
      render();
      scheduleVideoPreloads(state.presetIndex);
    }catch(err){
      if(loadToken === state.activeLoadToken){
        alert(isVideo ? 'VR動画の読み込みに失敗しました。' : 'VR画像の読み込みに失敗しました。');
      }
    }finally{
      if(loadToken === state.activeLoadToken && !loadingClosed){
        setLoading(false);
      }
    }
  }
  async function loadPresetByIndex(index){
    const item = Array.isArray(IMAGE_PRESETS) ? IMAGE_PRESETS[index] : null;
    if(!item || !item.image) return;
    await loadMediaSource(item, item.label || String(index + 1));
  }

  async function loadInitialPreset(){
    const item = Array.isArray(IMAGE_PRESETS) ? IMAGE_PRESETS[0] : null;
    if(!item || !item.image){
      setLoading(false);
      alert('VR画像が設定されていません。');
      return;
    }
    state.presetIndex = 0;
    renderImagePresetButtons();
    await loadPresetByIndex(0);
  }

  function getScreenOrientRad(){
    const angle = (screen.orientation && typeof screen.orientation.angle === 'number')
      ? screen.orientation.angle
      : (typeof window.orientation === 'number' ? window.orientation : 0);
    return THREE.MathUtils.degToRad(angle || 0);
  }

  function getDeviceQuaternion(alpha, beta, gamma){
    const alphaRad = THREE.MathUtils.degToRad(alpha || 0);
    const betaRad = THREE.MathUtils.degToRad(beta || 0);
    const gammaRad = THREE.MathUtils.degToRad(gamma || 0);
    const orient = getScreenOrientRad();

    euler.set(betaRad, alphaRad, -gammaRad, 'YXZ');
    const quaternion = new THREE.Quaternion();
    quaternion.setFromEuler(euler);
    quaternion.multiply(q1);
    quaternion.multiply(q0.setFromAxisAngle(zee, -orient));
    return quaternion;
  }

  function updateViewFromQuaternion(relativeQuat){
    const rot = new THREE.Euler().setFromQuaternion(relativeQuat, 'YXZ');
    state.yaw = wrap180(THREE.MathUtils.radToDeg(rot.y));
    state.pitch = clamp(THREE.MathUtils.radToDeg(rot.x), -85, 85);
    state.roll = wrap180(THREE.MathUtils.radToDeg(rot.z));
  }

  function resetGyroOrigin(){
    state.gyroBaseQuat = null;
    state.yaw = 0;
    state.pitch = 0;
    state.roll = 0;
    render();
  }

  function resetZoom(){
    state.fov = state.initialFov;
    render();
  }

  async function requestGyroPermission(){
    try{
      const isSecure = window.isSecureContext || location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      if(!isSecure){
        alert('ジャイロは HTTPS または localhost で利用してください。');
        return false;
      }

      const requests = [];

      if(typeof DeviceOrientationEvent !== 'undefined' &&
         typeof DeviceOrientationEvent.requestPermission === 'function'){
        requests.push(DeviceOrientationEvent.requestPermission());
      }

      if(typeof DeviceMotionEvent !== 'undefined' &&
         typeof DeviceMotionEvent.requestPermission === 'function'){
        requests.push(DeviceMotionEvent.requestPermission());
      }

      if(requests.length === 0){
        return true;
      }

      const results = await Promise.all(requests);
      return results.every(result => result === 'granted');
    }catch(err){
      return false;
    }
  }

  function onOrientation(e){
    if(state.mode !== 'gyro') return;
    if(e.alpha == null || e.beta == null || e.gamma == null) return;

    state.orientationReceived = true;
    const deviceQuat = getDeviceQuaternion(e.alpha, e.beta, e.gamma);

    if(!state.gyroBaseQuat){
      state.gyroBaseQuat = deviceQuat.clone().invert();
      state.smoothQuat.identity();
      state.currentQuat.identity();
    }

    state.currentQuat.copy(state.gyroBaseQuat).multiply(deviceQuat);

    if(state.smoothQuat.dot(state.currentQuat) < 0){
      state.currentQuat.x *= -1;
      state.currentQuat.y *= -1;
      state.currentQuat.z *= -1;
      state.currentQuat.w *= -1;
    }

    state.smoothQuat.slerp(state.currentQuat, 0.12);
    updateViewFromQuaternion(state.smoothQuat);
  }

  function activateGyroMode(){
    state.orientationReceived = false;
    state.mode = 'gyro';
    updateModeButtons();
    resetGyroOrigin();

    setTimeout(() => {
      if(state.mode === 'gyro' && !state.orientationReceived){
        state.mode = 'drag';
        updateModeButtons();
      }
    }, 1200);
  }

  async function switchToGyroMode(){
    const ok = await requestGyroPermission();
    if(ok){
      activateGyroMode();
    }else{
      state.mode = 'drag';
      updateModeButtons();
      alert('ジャイロを有効化できませんでした。');
    }
  }

  function switchToDragMode(){
    state.mode = 'drag';
    updateModeButtons();
  }

  async function toggleFullscreen(){
    if(!canFullscreen()) return;
    try{
      if(!document.fullscreenElement){
        await document.documentElement.requestFullscreen();
      }else{
        await document.exitFullscreen();
      }
    }catch(err){
    }
  }

  async function startVR(){
    if(!navigator.xr || !navigator.xr.isSessionSupported) return;
    try{
      const supported = await navigator.xr.isSessionSupported('immersive-vr');
      if(!supported) return;
      const session = await navigator.xr.requestSession('immersive-vr', {
        optionalFeatures: ['local-floor', 'bounded-floor']
      });
      renderer.xr.setSession(session);
    }catch(err){
    }
  }

  function getPointerDistance(){
    const points = Array.from(activePointers.values());
    if(points.length < 2) return 0;
    const dx = points[0].x - points[1].x;
    const dy = points[0].y - points[1].y;
    return Math.hypot(dx, dy);
  }

  viewer.addEventListener('pointerdown', (e) => {
    resumeAudioContext();
    state.dragging = true;
    state.lastX = e.clientX;
    state.lastY = e.clientY;
    state.tapDownX = e.clientX;
    state.tapDownY = e.clientY;
    state.tapDownTime = performance.now();

    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if(activePointers.size === 2){
      pinchStartDistance = getPointerDistance();
      pinchStartFov = state.fov;
    }
  });

  viewer.addEventListener('pointermove', (e) => {
    if(activePointers.has(e.pointerId)){
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    }

    if(activePointers.size >= 2){
      const currentDistance = getPointerDistance();
      if(pinchStartDistance > 0 && currentDistance > 0){
        const scale = currentDistance / pinchStartDistance;
        const nextFov = pinchStartFov / scale;
        state.fov = clamp(nextFov, state.minFov, state.maxFov);
      }
      return;
    }

    if(!state.dragging) return;
    if(state.mode !== 'drag') return;

    const dx = e.clientX - state.lastX;
    const dy = e.clientY - state.lastY;
    state.lastX = e.clientX;
    state.lastY = e.clientY;

    state.yaw = wrap180(state.yaw - dx * 0.18);
    state.pitch = clamp(state.pitch - dy * 0.16, -85, 85);
  });

  function endPointer(e){
    if(activePointers.has(e.pointerId)){
      activePointers.delete(e.pointerId);
    }

    if(activePointers.size < 2){
      pinchStartDistance = 0;
      pinchStartFov = state.fov;
    }

    if(!state.dragging) return;
    state.dragging = false;

    const dt = performance.now() - state.tapDownTime;
    const move = Math.hypot(e.clientX - state.tapDownX, e.clientY - state.tapDownY);

    if(dt < 250 && move < 10 && activePointers.size === 0){
      if(state.hiddenMenu){
        setMenuHidden(false);
      }else if(!menu.contains(e.target)){
        setMenuHidden(true);
      }
    }
  }

  viewer.addEventListener('pointerup', endPointer);
  viewer.addEventListener('pointercancel', endPointer);
  viewer.addEventListener('pointerleave', endPointer);
  viewer.addEventListener('wheel', (e) => {
    e.preventDefault();
    state.fov = clamp(state.fov + (e.deltaY > 0 ? 3 : -3), state.minFov, state.maxFov);
  }, { passive: false });

  dragModeBtn.addEventListener('click', () => {
    switchToDragMode();
  });

  gyroModeBtn.addEventListener('click', async () => {
    await switchToGyroMode();
  });

  recenterBtn.addEventListener('click', resetGyroOrigin);
  resetZoomBtn.addEventListener('click', resetZoom);
  fullscreenBtn.addEventListener('click', toggleFullscreen);
  vrBtn.addEventListener('click', startVR);

  window.addEventListener('resize', resize);
  window.addEventListener('orientationchange', resetGyroOrigin);
  window.addEventListener('deviceorientation', onOrientation, true);

  if(!canFullscreen()){
    fullscreenBtn.style.display = 'none';
  }

  if(!navigator.xr || !navigator.xr.isSessionSupported){
    vrBtn.style.display = 'none';
  }else{
    navigator.xr.isSessionSupported('immersive-vr').then((supported) => {
      if(!supported){
        vrBtn.style.display = 'none';
      }
    }).catch(() => {
      vrBtn.style.display = 'none';
    });
  }

  updateModeButtons();
  renderImagePresetButtons();
  initThree();
  setLoading(true, '画像を読み込み中...');
  loadInitialPreset();
})();
</script>
</body>
</html>
