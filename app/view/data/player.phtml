<?php
$embedUrl = $this->view->embed;
$videoUrl = $this->view->video;
$downloadUrl = $this->view->download;
$playlist = !empty($this->view->videoPlaylist) && is_array($this->view->videoPlaylist)
  ? $this->view->videoPlaylist
  : [];
$playlistGroups = isset($playlist['groups']) && is_array($playlist['groups']) ? $playlist['groups'] : [];
$hasPlaylist = !empty($playlistGroups);
$currentContentId = (int)($playlist['current_content_id'] ?? 0);
$currentFileId = (int)($playlist['current_file_id'] ?? 0);
$currentGroupTitle = '';
$currentVideoTitle = '';

if ($hasPlaylist) {
  foreach ($playlistGroups as $group) {
    if ((int)($group['content_id'] ?? 0) !== $currentContentId) {
      continue;
    }
    $currentGroupTitle = (string)($group['title'] ?? '');
    foreach (($group['videos'] ?? []) as $video) {
      if ((int)($video['file_id'] ?? 0) !== $currentFileId) {
        continue;
      }
      $currentVideoTitle = (string)($video['title'] ?? '');
      $videoUrl = (string)($video['source_url'] ?? $videoUrl);
      $downloadUrl = (string)($video['download_url'] ?? $downloadUrl);
      break 2;
    }
  }
}

$playlistJson = $hasPlaylist
  ? json_encode($playlist, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)
  : '{}';
if ($playlistJson === false) {
  $hasPlaylist = false;
  $playlistGroups = [];
  $playlistJson = '{}';
}
