        <h2 class="playlist-heading"><?php $this->h->p($currentGroupTitle); ?></h2>
      </div>
      <div class="playback-mode">
        <span class="mode-label">再生モード</span>
        <div class="mode-buttons" role="group" aria-label="再生モード">
          <button class="mode-button" type="button" data-mode="continuous" aria-pressed="false">連続再生</button>
          <button class="mode-button" type="button" data-mode="single-loop" aria-pressed="false">1本ループ</button>
        </div>
      </div>
      <ol id="videoList" class="video-list"></ol>
    </aside>
  </div>

  <script>
  (function () {
    'use strict';

    const playlist = <?php echo $playlistJson ?: '{}'; ?>;
    const groups = Array.isArray(playlist.groups) ? playlist.groups : [];
    const player = document.getElementById('videoPlayer');
    const videoList = document.getElementById('videoList');
    const currentGroupName = document.getElementById('currentGroupName');
    const currentVideoName = document.getElementById('currentVideoName');
    const adminNotice = document.getElementById('adminNotice');
    const downloadVideo = document.getElementById('downloadVideo');
    const previousVideo = document.getElementById('previousVideo');
    const nextVideo = document.getElementById('nextVideo');
    const modeButtons = Array.from(document.querySelectorAll('[data-mode]'));
    const storageKey = 'nill-video-playback-mode';
    const validModes = ['continuous', 'single-loop'];
    let currentGroupIndex = groups.findIndex(function (group) {
      return Number(group.content_id) === Number(playlist.current_content_id);
    });
    if (currentGroupIndex < 0) currentGroupIndex = 0;
    let currentVideoIndex = Math.max(0, (groups[currentGroupIndex].videos || []).findIndex(function (video) {
      return Number(video.file_id) === Number(playlist.current_file_id);
    }));
    let playbackMode = 'continuous';

    try {
      const savedMode = localStorage.getItem(storageKey);
      if (validModes.indexOf(savedMode) !== -1) {
        playbackMode = savedMode;
      }
    } catch (error) {}

    function currentGroup() {
      return groups[currentGroupIndex] || { videos: [] };
    }

    function currentVideo() {
      return (currentGroup().videos || [])[currentVideoIndex] || null;
    }

    function targetVideoIndex(direction) {
      const videos = currentGroup().videos || [];
      const target = currentVideoIndex + direction;
      if (target >= 0 && target < videos.length) return target;
      if (playbackMode === 'continuous' && videos.length > 0) {
        return direction > 0 ? 0 : videos.length - 1;
      }
      return -1;
    }

    function updateMode() {
      player.loop = playbackMode === 'single-loop';
      modeButtons.forEach(function (button) {
        button.setAttribute('aria-pressed', button.dataset.mode === playbackMode ? 'true' : 'false');
      });
      previousVideo.disabled = targetVideoIndex(-1) < 0;
      nextVideo.disabled = targetVideoIndex(1) < 0;
    }

    function updateCurrentDetails() {
      const group = currentGroup();
      const video = currentVideo();
      if (!video) return;
      currentGroupName.textContent = group.title || '';
      currentVideoName.textContent = video.title || '';
      downloadVideo.href = video.download_url;
      adminNotice.textContent = group.notice || '';
      adminNotice.hidden = !group.notice;
      Array.from(videoList.querySelectorAll('button')).forEach(function (button, index) {
        const isCurrent = index === currentVideoIndex;
        button.classList.toggle('is-current', isCurrent);
        button.setAttribute('aria-current', isCurrent ? 'true' : 'false');
      });
      updateMode();
    }

    function renderVideoList() {
      const videos = currentGroup().videos || [];
      videoList.replaceChildren();
      videos.forEach(function (video, index) {
        const item = document.createElement('li');
        const button = document.createElement('button');
        const number = document.createElement('span');
        const title = document.createElement('span');
        button.type = 'button';
        button.className = 'video-item-button';
        button.addEventListener('click', function () {
          selectVideo(currentGroupIndex, index, true, true);
        });
        number.className = 'video-number';
        number.textContent = String(index + 1);
        title.className = 'video-item-title';
        title.textContent = video.title || ('動画 ' + (index + 1));
        button.append(number, title);
        item.appendChild(button);
        videoList.appendChild(item);
      });
      updateCurrentDetails();
    }

    function selectVideo(groupIndex, videoIndex, autoplay, updateUrl) {
      const group = groups[groupIndex];
      const video = group && Array.isArray(group.videos) ? group.videos[videoIndex] : null;
      if (!video) return;
      const groupChanged = currentGroupIndex !== groupIndex;
      currentGroupIndex = groupIndex;
      currentVideoIndex = videoIndex;
      if (groupChanged) renderVideoList();
      player.pause();
      player.src = video.source_url;
      player.load();
      updateCurrentDetails();
      if (updateUrl && window.history && window.history.replaceState) {
        window.history.replaceState(null, '', video.player_url);
      }
      if (autoplay) {
        const playPromise = player.play();
        if (playPromise && typeof playPromise.catch === 'function') playPromise.catch(function () {});
      }
    }

    previousVideo.addEventListener('click', function () {
      const target = targetVideoIndex(-1);
      if (target >= 0) selectVideo(currentGroupIndex, target, true, true);
    });

    nextVideo.addEventListener('click', function () {
      const target = targetVideoIndex(1);
      if (target >= 0) selectVideo(currentGroupIndex, target, true, true);
    });

    modeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        playbackMode = button.dataset.mode;
        try {
          localStorage.setItem(storageKey, playbackMode);
        } catch (error) {}
        updateMode();
      });
    });

    player.addEventListener('ended', function () {
      if (playbackMode === 'single-loop') return;
      const target = targetVideoIndex(1);
      if (target >= 0) selectVideo(currentGroupIndex, target, true, true);
    });

    renderVideoList();
    updateMode();
  })();
  </script>
<?php endif; ?>
</body>
