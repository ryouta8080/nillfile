<?php
$rows = $this->view->rows ?? [];
$contents = $this->view->contents ?? [];
$setting = $this->view->setting ?? [];
$requestTypes = $this->view->requestTypes ?? [];
$requestTypeLabels = [];
foreach ($requestTypes as $requestType) {
    $requestTypeLabels[(string)$requestType['type_code']] = (string)$requestType['type_label'];
}
$filters = $this->view->filters ?? ['state' => 'open', 'favorite' => false, 'q' => ''];
$pagination = $this->view->pagination ?? ['page' => 1, 'per_page' => 50, 'total_pages' => 1, 'total' => count($rows)];
$csrf = (string)($this->view->csrf ?? '');
$errors = $this->view->errors ?? [];
$infos = $this->view->infos ?? [];
$requestTotal = (int)($pagination['total'] ?? count($rows));
$requestPage = max(1, (int)($pagination['page'] ?? 1));
$requestPerPage = max(1, (int)($pagination['per_page'] ?? 50));
$requestRangeStart = $requestTotal > 0 ? (($requestPage - 1) * $requestPerPage) + 1 : 0;
$requestRangeEnd = min($requestTotal, $requestPage * $requestPerPage);

if (!function_exists('request_admin_h')) {
    function request_admin_h($value): string {
        return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
    }
}

if (!function_exists('request_admin_type_label')) {
    function request_admin_type_label($value): string {
        $labels = ['image' => '画像', 'movie' => '動画', 'vr' => 'VR', 'other' => 'その他'];
        return $labels[(string)$value] ?? 'その他';
    }
}

$requestAdminPageUrl = function(int $page) use ($filters): string {
    $params = [
        'state' => (string)($filters['state'] ?? 'open'),
        'q' => (string)($filters['q'] ?? ''),
        'page' => $page,
    ];
    if (!empty($filters['favorite'])) $params['favorite'] = 1;
    if ($params['q'] === '') unset($params['q']);
    return '/account/request?' . http_build_query($params);
};

