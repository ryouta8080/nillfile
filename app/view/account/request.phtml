          <a class="page-link" href="<?php echo request_admin_h($requestAdminPageUrl(max(1, $currentPage - 1))); ?>" aria-label="前のページ"><i class="bi bi-chevron-left"></i></a>
        </li>
        <?php for ($pageNumber = $startPage; $pageNumber <= $endPage; $pageNumber++): ?>
          <li class="page-item<?php echo $pageNumber === $currentPage ? ' active' : ''; ?>">
            <a class="page-link" href="<?php echo request_admin_h($requestAdminPageUrl($pageNumber)); ?>"><?php echo $pageNumber; ?></a>
          </li>
        <?php endfor; ?>
        <li class="page-item<?php echo $currentPage >= $totalPages ? ' disabled' : ''; ?>">
          <a class="page-link" href="<?php echo request_admin_h($requestAdminPageUrl(min($totalPages, $currentPage + 1))); ?>" aria-label="次のページ"><i class="bi bi-chevron-right"></i></a>
        </li>
      </ul>
    </nav>
  <?php endif; ?>
</main>

<script>
(function(){
  var csrf = <?php echo json_encode($csrf, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;

  function updateRow(input){
    var row = input.closest('.js-request-row');
    if (!row) return;
    if (input.dataset.field === 'favorite_flag') {
      var indicator = row.querySelector('.js-favorite-indicator');
      if (indicator) indicator.classList.toggle('d-none', !input.checked);
      return;
    }

    var status = row.querySelector('.js-request-status');
    var hiddenInput = row.querySelector('[data-field="hidden_flag"]');
    var doneInput = row.querySelector('[data-field="done_flag"]');
    if (!status || !hiddenInput || !doneInput) return;
    status.classList.remove('text-bg-dark', 'text-bg-secondary', 'text-bg-success', 'text-bg-primary');
    if (hiddenInput.checked) {
      status.textContent = '非表示';
      status.classList.add('text-bg-dark');
    } else if (row.dataset.withdrawn === '1') {
      status.textContent = '取り下げ';
      status.classList.add('text-bg-secondary');
    } else if (doneInput.checked) {
      status.textContent = '完了';
      status.classList.add('text-bg-success');
    } else {
      status.textContent = '未完了';
      status.classList.add('text-bg-primary');
    }
  }

  document.querySelectorAll('.js-request-flag').forEach(function(input){
    input.addEventListener('change', async function(){
      var nextChecked = input.checked;
      input.disabled = true;
      try {
        var body = new URLSearchParams();
        body.set('_csrf', csrf);
        body.set('operation', 'update_request_flag');
        body.set('request_id', input.dataset.requestId || '0');
        body.set('field', input.dataset.field || '');
        body.set('value', nextChecked ? '1' : '0');
        var response = await fetch('/account/request', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
          },
          body: body.toString()
        });
        var data = await response.json().catch(function(){ return {}; });
        if (!response.ok || !data.success) throw new Error(data.message || '更新に失敗しました。');
        updateRow(input);
      } catch (error) {
        input.checked = !nextChecked;
        alert(error.message || '更新に失敗しました。');
      } finally {
        input.disabled = false;
      }
    });
  });
})();
</script>

<?php $this->load($this->getViewPath() . 'footer.phtml'); ?>
