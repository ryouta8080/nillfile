<?php
$rows = $this->view->rows ?? [];
$csrf = $this->view->csrf ?? '';
$errors = $this->view->errors ?? [];
$infos = $this->view->infos ?? [];

$groups = [];
foreach ($rows as $row) {
    $contentId = (int)($row['content_id'] ?? 0);
    if ($contentId <= 0) continue;
    if (!isset($groups[$contentId])) {
        $groups[$contentId] = [
            'item' => $row,
            'files' => [],
        ];
    }
    if (!empty($row['file_id'])) {
        $groups[$contentId]['files'][] = $row;
    }
}

if (!function_exists('content_v2_h')) {
    function content_v2_h($value): string {
        return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
    }
}

if (!function_exists('content_v2_dt_local')) {
    function content_v2_dt_local($value): string {
        $value = trim((string)$value);
        if ($value === '') return '';
        return str_replace(' ', 'T', substr($value, 0, 16));
    }
}

if (!function_exists('content_v2_selected')) {
    function content_v2_selected($value, $current): string {
        return ((string)$value === (string)$current) ? ' selected' : '';
    }
}

if (!function_exists('content_v2_label')) {
    function content_v2_label($value): string {
        $labels = [
            'movie' => '動画',
            'image' => '画像',
            'audio' => '音声',
            'zip' => 'ZIP',
            'file' => 'ファイル',
            'bookmarklet' => 'ブックマークレット',
            'vr' => 'VR',
            'paid' => '支援者向け',
            'free' => '無料',
            'draft' => '下書き',
            'private' => '非公開',
            'published' => '公開',
            'scheduled' => '予約公開',
        ];
        $value = (string)$value;
        return $labels[$value] ?? $value;
    }
}

$host = $_SERVER['HTTP_HOST'] ?? 'file.nilwork.net';
$baseUrl = 'https://' . $host;
$defaultSuffix = (new DateTime('now', new DateTimeZone('Asia/Tokyo')))->format('Ymd');
$vrMediaOptions = [];
$vrAudioOptions = [];
$vrSeenMedia = [];
$vrSeenAudio = [];
foreach ($rows as $row) {
    $code = trim((string)($row['code'] ?? ''));
    if ($code === '') continue;
    $fileType = (string)($row['file_type'] ?? '');
    $mimeType = (string)($row['mime_type'] ?? '');
    $name = (string)($row['display_name'] ?: ($row['original_name'] ?? $code));
    $label = $name . ' / ' . $code;
    if (($fileType === 'image' || $fileType === 'movie' || strpos($mimeType, 'image/') === 0 || strpos($mimeType, 'video/') === 0) && empty($vrSeenMedia[$code])) {
        $vrMediaOptions[] = [
            'code' => $code,
            'label' => $label,
            'type' => ($fileType === 'movie' || strpos($mimeType, 'video/') === 0) ? 'video' : 'image',
        ];
        $vrSeenMedia[$code] = true;
    }
    if (($fileType === 'audio' || $fileType === 'file' || $fileType === 'movie' || strpos($mimeType, 'audio/') === 0 || strpos($mimeType, 'video/') === 0) && empty($vrSeenAudio[$code])) {
        $vrAudioOptions[] = [
            'code' => $code,
            'label' => $label,
        ];
        $vrSeenAudio[$code] = true;
    }
}

