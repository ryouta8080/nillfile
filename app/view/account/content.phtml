<script>
(function(){
  function copy(text){
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text);
      return;
    }
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  }
  document.querySelectorAll('.js-copy-url').forEach(function(btn){
    btn.addEventListener('click', function(){
      copy(btn.getAttribute('data-url') || '');
    });
  });
  document.querySelectorAll('.js-copy-textarea').forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = document.getElementById(btn.getAttribute('data-target') || '');
      copy(target ? target.value : '');
    });
  });

  var vrMediaOptions = <?php echo json_encode($vrMediaOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
  var vrAudioOptions = <?php echo json_encode($vrAudioOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
  function ensureVrDatalist(id, options){
    if (document.getElementById(id)) return;
    var list = document.createElement('datalist');
    list.id = id;
    (options || []).forEach(function(option){
      var opt = document.createElement('option');
      opt.value = option.code || '';
      opt.label = option.label || option.code || '';
      list.appendChild(opt);
    });
    document.body.appendChild(list);
  }
  ensureVrDatalist('vrMediaCodeList', vrMediaOptions);
  ensureVrDatalist('vrAudioCodeList', vrAudioOptions);

  function parseVrJson(textarea){
    var text = (textarea && textarea.value ? textarea.value : '').trim();
    if (!text) return {};
    try {
      var data = JSON.parse(text);
      return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
    } catch (e) {
      alert('詳細設定JSONの形式が正しくありません。');
      return null;
    }
  }
  function createVrInput(labelText, className, type, value){
    var wrap = document.createElement('div');
    wrap.className = 'col-md-3';
    var label = document.createElement('label');
    label.className = 'form-label small mb-1';
    label.textContent = labelText;
    var input = document.createElement('input');
    input.className = 'form-control form-control-sm ' + className;
    input.type = type || 'text';
    if (value !== undefined && value !== null) input.value = value;
    wrap.appendChild(label);
    wrap.appendChild(input);
    return wrap;
  }
  function getVrInput(row, selector){
    return row.querySelector(selector);
  }
  function addVrAudioRow(audioWrap, audio){
    audio = audio || {};
    var row = document.createElement('div');
    row.className = 'row g-2 align-items-end mb-2 js-vr-audio';

    var fileCol = createVrInput('音声コード', 'js-vr-audio-file', 'text', audio.file || audio.audio || audio.src || '');
    getVrInput(fileCol, 'input').setAttribute('list', 'vrAudioCodeList');
    row.appendChild(fileCol);
    row.appendChild(createVrInput('音量', 'js-vr-audio-volume', 'number', audio.volume !== undefined ? audio.volume : ''));
    getVrInput(row, '.js-vr-audio-volume').step = '0.1';
    getVrInput(row, '.js-vr-audio-volume').min = '0';

    var loopCol = document.createElement('div');
    loopCol.className = 'col-md-2';
    var loopLabel = document.createElement('label');
    loopLabel.className = 'form-label small mb-1 d-block';
    loopLabel.textContent = 'ループ';
    var loopCheckWrap = document.createElement('div');
    loopCheckWrap.className = 'form-check';
    var loopInput = document.createElement('input');
    loopInput.className = 'form-check-input js-vr-audio-loop';
    loopInput.type = 'checkbox';
    loopInput.checked = audio.loop !== false;
    var loopText = document.createElement('label');
    loopText.className = 'form-check-label small';
    loopText.textContent = '有効';
    loopCheckWrap.appendChild(loopInput);
    loopCheckWrap.appendChild(loopText);
    loopCol.appendChild(loopLabel);
    loopCol.appendChild(loopCheckWrap);
    row.appendChild(loopCol);

    var position = Array.isArray(audio.position) ? audio.position : [];
    ['X','Y','Z'].forEach(function(axis, index){
      var col = createVrInput('位置' + axis, 'js-vr-audio-pos-' + index, 'number', position[index] !== undefined ? position[index] : '');
      getVrInput(col, 'input').step = '0.1';
      row.appendChild(col);
    });

    var actionCol = document.createElement('div');
    actionCol.className = 'col-md-1';
    var removeBtn = document.createElement('button');
    removeBtn.className = 'btn btn-outline-danger btn-sm';
    removeBtn.type = 'button';
    removeBtn.textContent = '削除';
    removeBtn.addEventListener('click', function(){
      row.parentNode.removeChild(row);
    });
    actionCol.appendChild(removeBtn);
    row.appendChild(actionCol);
    audioWrap.appendChild(row);
  }
  function addVrPreset(panel, item){
    item = item || {};
    var items = panel.querySelector('.js-vr-items');
    var row = document.createElement('div');
    row.className = 'border rounded p-2 mb-2 bg-white js-vr-item';

    var top = document.createElement('div');
    top.className = 'row g-2 align-items-end';
    top.appendChild(createVrInput('ラベル', 'js-vr-label', 'text', item.label || ''));
    var fileCol = createVrInput('画像/動画コード', 'js-vr-file', 'text', item.file || item.image || item.src || '');
    getVrInput(fileCol, 'input').setAttribute('list', 'vrMediaCodeList');
    fileCol.className = 'col-md-4';
    top.appendChild(fileCol);
    top.appendChild(createVrInput('向き yaw', 'js-vr-yaw', 'number', item.yaw !== undefined ? item.yaw : (item.yawOffset !== undefined ? item.yawOffset : '')));
    getVrInput(top, '.js-vr-yaw').step = '0.1';

    var preloadCol = document.createElement('div');
    preloadCol.className = 'col-md-2';
    var preloadLabel = document.createElement('label');
    preloadLabel.className = 'form-label small mb-1 d-block';
    preloadLabel.textContent = '事前読込';
    var preloadWrap = document.createElement('div');
    preloadWrap.className = 'form-check';
    var preload = document.createElement('input');
    preload.className = 'form-check-input js-vr-preload';
    preload.type = 'checkbox';
    preload.checked = item.preload === true;
    var preloadText = document.createElement('label');
    preloadText.className = 'form-check-label small';
    preloadText.textContent = '有効';
    preloadWrap.appendChild(preload);
    preloadWrap.appendChild(preloadText);
    preloadCol.appendChild(preloadLabel);
    preloadCol.appendChild(preloadWrap);
    top.appendChild(preloadCol);

    var removeCol = document.createElement('div');
    removeCol.className = 'col-md-1';
    var removeBtn = document.createElement('button');
    removeBtn.className = 'btn btn-outline-danger btn-sm';
    removeBtn.type = 'button';
    removeBtn.textContent = '削除';
    removeBtn.addEventListener('click', function(){
      row.parentNode.removeChild(row);
    });
    removeCol.appendChild(removeBtn);
    top.appendChild(removeCol);

    var audioHeader = document.createElement('div');
    audioHeader.className = 'd-flex align-items-center justify-content-between mt-2 mb-1';
    var audioTitle = document.createElement('div');
    audioTitle.className = 'small fw-semibold';
    audioTitle.textContent = '音声';
    var addAudioBtn = document.createElement('button');
    addAudioBtn.className = 'btn btn-outline-secondary btn-sm';
    addAudioBtn.type = 'button';
    addAudioBtn.textContent = '音声追加';
    audioHeader.appendChild(audioTitle);
    audioHeader.appendChild(addAudioBtn);

    var audioWrap = document.createElement('div');
    audioWrap.className = 'js-vr-audio-items';
    addAudioBtn.addEventListener('click', function(){
      addVrAudioRow(audioWrap, {});
    });

    row.appendChild(top);
    row.appendChild(audioHeader);
    row.appendChild(audioWrap);
    items.appendChild(row);

    if (Array.isArray(item.audio)) {
      item.audio.forEach(function(audio){
        addVrAudioRow(audioWrap, audio);
      });
    }
  }
  function loadVrPanel(panel){
    var form = panel.closest('form');
    var textarea = form ? form.querySelector('textarea[name="config_json"]') : null;
    var config = parseVrJson(textarea);
    if (config === null) return;
    var items = panel.querySelector('.js-vr-items');
    items.innerHTML = '';
    var images = config.image || [];
    if (!Array.isArray(images) && typeof images === 'object') {
      images = Object.keys(images).map(function(key){
        var value = images[key];
        if (typeof value === 'string') return { label: key, file: value };
        if (value && typeof value === 'object') {
          if (!value.label) value.label = key;
          return value;
        }
        return null;
      }).filter(function(value){ return !!value; });
    } else if (typeof images === 'string') {
      images = [{ file: images }];
    }
    images.forEach(function(item){
      if (typeof item === 'string') item = { file: item };
      addVrPreset(panel, item);
    });
  }
  function applyVrPanel(panel){
    var form = panel.closest('form');
    var textarea = form ? form.querySelector('textarea[name="config_json"]') : null;
    var config = parseVrJson(textarea);
    if (config === null) return false;
    var images = [];
    panel.querySelectorAll('.js-vr-item').forEach(function(row){
      var file = (getVrInput(row, '.js-vr-file').value || '').trim();
      if (!file) return;
      var item = { file: file };
      var label = (getVrInput(row, '.js-vr-label').value || '').trim();
      var yaw = (getVrInput(row, '.js-vr-yaw').value || '').trim();
      if (label) item.label = label;
      if (yaw !== '') item.yaw = Number(yaw);
      if (getVrInput(row, '.js-vr-preload').checked) item.preload = true;

      var audioItems = [];
      row.querySelectorAll('.js-vr-audio').forEach(function(audioRow){
        var audioFile = (getVrInput(audioRow, '.js-vr-audio-file').value || '').trim();
        if (!audioFile) return;
        var audio = { file: audioFile };
        var volume = (getVrInput(audioRow, '.js-vr-audio-volume').value || '').trim();
        if (volume !== '') audio.volume = Number(volume);
        audio.loop = getVrInput(audioRow, '.js-vr-audio-loop').checked;
        var position = [];
        [0,1,2].forEach(function(index){
          var value = (getVrInput(audioRow, '.js-vr-audio-pos-' + index).value || '').trim();
          position[index] = value === '' ? 0 : Number(value);
        });
        if (position.some(function(value){ return value !== 0; })) audio.position = position;
        audioItems.push(audio);
      });
      if (audioItems.length) item.audio = audioItems;
      images.push(item);
    });
    if (images.length) {
      config.image = images;
    } else {
      delete config.image;
    }
    textarea.value = JSON.stringify(config, null, 2);
    return true;
  }
  function updateVrPanelVisibility(panel){
    var form = panel.closest('form');
    var typeSelect = form ? form.querySelector('select[name="content_type"]') : null;
    var type = typeSelect ? typeSelect.value : (panel.getAttribute('data-content-type') || '');
    var visible = type === 'vr';
    panel.style.display = visible ? '' : 'none';
    if (visible && panel.querySelectorAll('.js-vr-item').length === 0) {
      loadVrPanel(panel);
      if (panel.querySelectorAll('.js-vr-item').length === 0) addVrPreset(panel, {});
    }
  }
  document.querySelectorAll('.js-vr-config').forEach(function(panel){
    panel.querySelector('.js-vr-load').addEventListener('click', function(){
      loadVrPanel(panel);
    });
    panel.querySelector('.js-vr-add').addEventListener('click', function(){
      addVrPreset(panel, {});
    });
    panel.querySelector('.js-vr-apply').addEventListener('click', function(){
      applyVrPanel(panel);
    });
    var form = panel.closest('form');
    var typeSelect = form ? form.querySelector('select[name="content_type"]') : null;
    if (typeSelect) {
      typeSelect.addEventListener('change', function(){
        updateVrPanelVisibility(panel);
      });
    }
    if (form) {
      form.addEventListener('submit', function(event){
        if (panel.style.display !== 'none' && panel.querySelectorAll('.js-vr-item').length > 0) {
          if (!applyVrPanel(panel)) event.preventDefault();
        }
      });
    }
    loadVrPanel(panel);
    updateVrPanelVisibility(panel);
  });

  var uploadInput = document.getElementById('contentUploadFiles');
  var uploadList = document.getElementById('contentUploadFileList');
  var uploadPreviewUrls = [];
  var uploadLargePreviewUrl = '';
  var uploadLargePreviewOverlay = null;
  function clearUploadPreviewUrls(){
    closeUploadLargePreview();
    uploadPreviewUrls.forEach(function(url){
      URL.revokeObjectURL(url);
    });
    uploadPreviewUrls = [];
  }
  function closeUploadLargePreview(){
    if (uploadLargePreviewOverlay && uploadLargePreviewOverlay.parentNode) {
      uploadLargePreviewOverlay.parentNode.removeChild(uploadLargePreviewOverlay);
    }
    uploadLargePreviewOverlay = null;
    if (uploadLargePreviewUrl) {
      URL.revokeObjectURL(uploadLargePreviewUrl);
      uploadLargePreviewUrl = '';
    }
  }
  function openUploadLargePreview(file){
    closeUploadLargePreview();
    var type = file.type || '';
    var overlay = document.createElement('div');
    overlay.className = 'position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3';
    overlay.style.background = 'rgba(0,0,0,.72)';
    overlay.style.zIndex = '1080';
    overlay.tabIndex = -1;

    var panel = document.createElement('div');
    panel.className = 'bg-white rounded shadow p-3';
    panel.style.maxWidth = '94vw';
    panel.style.maxHeight = '94vh';

    var header = document.createElement('div');
    header.className = 'd-flex align-items-center justify-content-between gap-3 mb-2';
    var title = document.createElement('div');
    title.className = 'fw-bold text-truncate';
    title.style.maxWidth = '75vw';
    title.textContent = file.name;
    var closeBtn = document.createElement('button');
    closeBtn.className = 'btn btn-outline-secondary btn-sm';
    closeBtn.type = 'button';
    closeBtn.textContent = '閉じる';
    closeBtn.addEventListener('click', closeUploadLargePreview);
    header.appendChild(title);
    header.appendChild(closeBtn);

    var body = document.createElement('div');
    body.className = 'd-flex align-items-center justify-content-center bg-light';
    body.style.minWidth = '240px';
    body.style.minHeight = '160px';
    body.style.maxWidth = '90vw';
    body.style.maxHeight = '84vh';
    body.style.overflow = 'auto';

    if (/^(image|video|audio)\//.test(type)) {
      uploadLargePreviewUrl = URL.createObjectURL(file);
    }
    if (/^image\//.test(type)) {
      var img = document.createElement('img');
      img.src = uploadLargePreviewUrl;
      img.alt = file.name;
      img.style.maxWidth = '90vw';
      img.style.maxHeight = '82vh';
      img.style.objectFit = 'contain';
      body.appendChild(img);
    } else if (/^video\//.test(type)) {
      var video = document.createElement('video');
      video.src = uploadLargePreviewUrl;
      video.controls = true;
      video.playsInline = true;
      video.preload = 'metadata';
      video.style.maxWidth = '90vw';
      video.style.maxHeight = '82vh';
      body.appendChild(video);
    } else if (/^audio\//.test(type)) {
      var audio = document.createElement('audio');
      audio.src = uploadLargePreviewUrl;
      audio.controls = true;
      audio.preload = 'metadata';
      audio.style.width = '80vw';
      audio.style.maxWidth = '720px';
      body.appendChild(audio);
    } else {
      var fallback = document.createElement('div');
      fallback.className = 'text-secondary p-4';
      fallback.textContent = type || 'preview unavailable';
      body.appendChild(fallback);
    }

    panel.appendChild(header);
    panel.appendChild(body);
    overlay.appendChild(panel);
    overlay.addEventListener('click', function(event){
      if (event.target === overlay) closeUploadLargePreview();
    });
    overlay.addEventListener('keydown', function(event){
      if (event.key === 'Escape') closeUploadLargePreview();
    });
    document.body.appendChild(overlay);
    uploadLargePreviewOverlay = overlay;
    closeBtn.focus();
  }
  function createUploadPreview(file){
    var box = document.createElement('div');
    box.className = 'border rounded bg-white d-flex align-items-center justify-content-center overflow-hidden';
    box.style.width = '120px';
    box.style.height = '80px';
    box.style.maxWidth = '100%';
    var type = file.type || '';
    box.title = 'クリックで拡大表示';
    box.style.cursor = 'zoom-in';
    box.tabIndex = 0;
    box.addEventListener('click', function(event){
      if (/^(video|audio)\//.test(type) && event.target !== box) return;
      openUploadLargePreview(file);
    });
    box.addEventListener('keydown', function(event){
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openUploadLargePreview(file);
    });
    var url = '';
    if (/^(image|video|audio)\//.test(type)) {
      url = URL.createObjectURL(file);
      uploadPreviewUrls.push(url);
    }
    if (/^image\//.test(type)) {
      var img = document.createElement('img');
      img.src = url;
      img.alt = file.name;
      img.style.maxWidth = '100%';
      img.style.maxHeight = '100%';
      img.style.objectFit = 'contain';
      box.appendChild(img);
      return box;
    }
    if (/^video\//.test(type)) {
      var video = document.createElement('video');
      video.src = url;
      video.controls = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'metadata';
      video.style.width = '100%';
      video.style.height = '100%';
      video.style.objectFit = 'contain';
      box.appendChild(video);
      return box;
    }
    if (/^audio\//.test(type)) {
      var audio = document.createElement('audio');
      audio.src = url;
      audio.controls = true;
      audio.preload = 'metadata';
      audio.style.width = '110px';
      box.appendChild(audio);
      return box;
    }
    var fallback = document.createElement('span');
    fallback.className = 'small text-secondary text-center px-2';
    fallback.textContent = type || 'preview unavailable';
    box.appendChild(fallback);
    return box;
  }
  function renderUploadFiles(){
    if (!uploadInput || !uploadList) return;
    clearUploadPreviewUrls();
    var files = Array.prototype.slice.call(uploadInput.files || []);
    uploadList.innerHTML = '';
    if (!files.length) {
      var empty = document.createElement('div');
      empty.className = 'text-secondary small';
      empty.textContent = 'ファイルを選択すると、保存ファイル名を個別に編集できます。';
      if (!uploadInput.required) {
        empty.textContent = 'VRはファイルなしで作成できます。素材はVR設定で選択してください。';
      }
      uploadList.appendChild(empty);
      return;
    }
    files.forEach(function(file, index){
      var row = document.createElement('div');
      row.className = 'row g-2 align-items-center mb-2';

      var previewCol = document.createElement('div');
      previewCol.className = 'col-md-2';
      previewCol.appendChild(createUploadPreview(file));
      var largeBtn = document.createElement('button');
      largeBtn.className = 'btn btn-outline-secondary btn-sm mt-1';
      largeBtn.type = 'button';
      largeBtn.style.width = '120px';
      largeBtn.style.maxWidth = '100%';
      largeBtn.textContent = '拡大';
      largeBtn.addEventListener('click', function(){
        openUploadLargePreview(file);
      });
      previewCol.appendChild(largeBtn);

      var nameCol = document.createElement('div');
      nameCol.className = 'col-md-4';
      var source = document.createElement('div');
      source.className = 'small text-secondary';
      source.textContent = (index + 1) + '. 選択ファイル: ' + file.name;
      nameCol.appendChild(source);
      var meta = document.createElement('div');
      meta.className = 'small text-secondary';
      meta.textContent = Math.ceil(file.size / 1024).toLocaleString() + ' KB';
      nameCol.appendChild(meta);

      var inputCol = document.createElement('div');
      inputCol.className = 'col-md-6';
      var input = document.createElement('input');
      input.className = 'form-control form-control-sm';
      input.type = 'text';
      input.name = 'upload_display_names[]';
      input.value = file.name;
      input.placeholder = '保存ファイル名';
      inputCol.appendChild(input);

      row.appendChild(previewCol);
      row.appendChild(nameCol);
      row.appendChild(inputCol);
      uploadList.appendChild(row);
    });
  }
  function updateUploadFileRequirement(){
    if (!uploadInput) return;
    var form = uploadInput.closest('form');
    var typeSelect = form ? form.querySelector('select[name="content_type"]') : null;
    uploadInput.required = !typeSelect || typeSelect.value !== 'vr';
    renderUploadFiles();
  }
  if (uploadInput) {
    var uploadForm = uploadInput.closest('form');
    var uploadTypeSelect = uploadForm ? uploadForm.querySelector('select[name="content_type"]') : null;
    if (uploadTypeSelect) {
      uploadTypeSelect.addEventListener('change', updateUploadFileRequirement);
    }
    uploadInput.addEventListener('change', renderUploadFiles);
    updateUploadFileRequirement();
  }
})();
</script>

