<?php
$csrf = (string)($this->view->csrf ?? '');
$setting = $this->view->setting ?? [];
$rows = $this->view->rows ?? [];
$requestTypes = $this->view->requestTypes ?? [];
$requestTypeLabels = $this->view->requestTypeLabels ?? [];
$pagination = $this->view->pagination ?? ['page' => 1, 'total_pages' => 1, 'total' => count($rows)];
$errors = $this->view->errors ?? [];
$formValues = $this->view->formValues ?? [];
$requestFlash = (string)($this->view->requestFlash ?? '');
$isPaid = !empty($this->view->isPaid);
$adminBypass = !empty($this->view->adminBypass);
$availableRequestTypes = [];
$requestLimitMessages = [];
$requestLimitReached = false;
$requestCooldownRemainingSeconds = null;
$requestCooldownMessage = '';
foreach ($requestTypes as $requestType) {
    if (!array_key_exists('available_flag', $requestType) || !empty($requestType['available_flag'])) {
        $availableRequestTypes[] = $requestType;
        continue;
    }
    if (!empty($requestType['limit_reached'])) {
        $requestLimitReached = true;
        continue;
    }
    $remainingSeconds = max(0, (int)($requestType['cooldown_remaining_seconds'] ?? 0));
    if ($remainingSeconds > 0 && ($requestCooldownRemainingSeconds === null || $remainingSeconds < $requestCooldownRemainingSeconds)) {
        $requestCooldownRemainingSeconds = $remainingSeconds;
        $requestCooldownMessage = (string)($requestType['restriction_message'] ?? '');
    }
}
if ($requestLimitReached) $requestLimitMessages[] = 'リクエストの上限に達しています。';
if ($requestCooldownMessage !== '') $requestLimitMessages[] = $requestCooldownMessage;
$canSubmit = !empty($setting['accept_flag']) && ($adminBypass || empty($setting['paid_only_flag']) || $isPaid) && !empty($availableRequestTypes);
$maxLength = max(1, (int)($setting['max_length'] ?? 2000));
$defaultRequestType = (string)($availableRequestTypes[0]['type_code'] ?? '');
$attachmentEnabled = !empty($setting['attachment_enabled_flag']);
$attachmentMaxSizeMb = max(1, min(50, (int)($setting['attachment_max_size_mb'] ?? 10)));

if (!function_exists('request_page_h')) {
    function request_page_h($value): string {
        return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
    }
}

if (!function_exists('request_page_type_label')) {
    function request_page_type_label($value): string {
        $labels = ['image' => '画像', 'movie' => '動画', 'vr' => 'VR', 'other' => 'その他'];
        return $labels[(string)$value] ?? 'その他';
    }
}

