<script>
(function(){
  var input = document.getElementById('requestText');
  var count = document.getElementById('requestLength');
  if (input && count) {
    function updateLength(){ count.textContent = Array.from(input.value).length; }
    input.addEventListener('input', updateLength);
    updateLength();
  }

  var form = document.getElementById('requestSubmitForm');
  var modalElement = document.getElementById('requestConfirmModal');
  var confirmButton = document.getElementById('requestConfirmSubmit');
  if (!form || !modalElement || !confirmButton) return;

  var attachmentInput = document.getElementById('requestAttachment');
  var attachmentPreview = document.getElementById('requestAttachmentPreview');
  var attachmentPreviewImage = document.getElementById('requestAttachmentPreviewImage');
  var attachmentRemove = document.getElementById('requestAttachmentRemove');
  var attachmentObjectUrl = '';
  var attachmentMaxBytes = <?php echo $attachmentMaxSizeMb * 1024 * 1024; ?>;
  var attachmentMimeTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];

  function clearAttachment(clearInput){
    if (!attachmentInput) return;
    if (clearInput !== false) attachmentInput.value = '';
    attachmentInput.setCustomValidity('');
    if (attachmentObjectUrl) URL.revokeObjectURL(attachmentObjectUrl);
    attachmentObjectUrl = '';
    if (attachmentPreviewImage) attachmentPreviewImage.removeAttribute('src');
    if (attachmentPreview) {
      attachmentPreview.classList.add('d-none');
      attachmentPreview.classList.remove('d-flex');
    }
  }

  if (attachmentInput) {
    attachmentInput.addEventListener('change', function(){
      var file = attachmentInput.files && attachmentInput.files[0] ? attachmentInput.files[0] : null;
      clearAttachment(false);
      if (!file) return;
      if (attachmentMimeTypes.indexOf(file.type) === -1) {
        alert('JPEG、PNG、WebP、GIFを選択してください。');
        clearAttachment(true);
        return;
      }
      if (file.size > attachmentMaxBytes) {
        alert('画像の容量が上限を超えています。');
        clearAttachment(true);
        return;
      }
      attachmentInput.setCustomValidity('');
      attachmentObjectUrl = URL.createObjectURL(file);
      if (attachmentPreviewImage) attachmentPreviewImage.src = attachmentObjectUrl;
      if (attachmentPreview) {
        attachmentPreview.classList.remove('d-none');
        attachmentPreview.classList.add('d-flex');
      }
    });
  }
  if (attachmentRemove) attachmentRemove.addEventListener('click', function(){ clearAttachment(true); });

  form.addEventListener('submit', function(event){
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    var type = document.getElementById('requestType');
    var nsfw = document.getElementById('requestNsfw');
    var selectedType = type && type.selectedOptions.length ? type.selectedOptions[0].textContent : '';
    document.getElementById('requestConfirmType').textContent = selectedType;
    document.getElementById('requestConfirmNsfw').textContent = nsfw && nsfw.checked ? '希望する' : '希望しない';
    document.getElementById('requestConfirmAttachment').textContent = attachmentInput && attachmentInput.files.length ? 'あり' : 'なし';
    document.getElementById('requestConfirmText').textContent = input ? input.value : '';
    bootstrap.Modal.getOrCreateInstance(modalElement).show();
  });

  confirmButton.addEventListener('click', function(){
    confirmButton.disabled = true;
    bootstrap.Modal.getOrCreateInstance(modalElement).hide();
    form.submit();
  });
})();
</script>

